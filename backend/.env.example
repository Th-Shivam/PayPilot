# ==============================================================================
# PayPilot backend configuration
#
# Copy to backend/.env and fill in. Never commit the copy — .gitignore already
# excludes .env while keeping this template tracked.
# ==============================================================================

APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# BACKEND ONLY — never expose to the browser
#
# The service role key carries BYPASSRLS. It reads and writes every table
# regardless of Row Level Security. Leaking it is equivalent to publishing full
# database credentials.
#
# It must NEVER appear in frontend/.env, and must NEVER carry a VITE_ prefix:
# Vite inlines every VITE_-prefixed variable into the client bundle, so a
# prefixed service role key ships to anyone who opens devtools.
# ------------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → API → Project API keys → anon (public)
# Present here for parity with the frontend; the backend uses the service role
# key for all agent operations.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# LLM — console.groq.com/keys
# ------------------------------------------------------------------------------

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=8
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Observability — logfire.pydantic.dev, optional.
# Unset means tracing is skipped; the resolve path still works.
# ------------------------------------------------------------------------------

LOGFIRE_TOKEN=

# ------------------------------------------------------------------------------
# Reconciliation behaviour
# ------------------------------------------------------------------------------

# Settlement window in days. A captured payment with no bank record past
# expected_settlement_at is an anomaly rather than a delay.
SETTLEMENT_WINDOW_DAYS=2

# Cosine similarity floor for similar-case retrieval, 0..1.
SIMILARITY_THRESHOLD=0.75
SIMILARITY_MATCH_COUNT=3

# Reference instant the T+2 settlement window is judged against. Leave unset in
# production to use the current time. For a demo over the seeded fixtures (dated
# 2025-01-15), pin it so every diagnosis path classifies as generated instead of
# drifting to `anomaly` as real time passes the seeded window:
#   RECONCILIATION_REFERENCE_DATE=2025-01-15T12:00:00+00:00
RECONCILIATION_REFERENCE_DATE=

# ------------------------------------------------------------------------------
# Auth (issue #13, Phase 5)
#
# REQUIRE_AUTH=false skips bearer token validation and injects a fixed
# support_agent identity, so frontend work is not blocked on auth landing.
# DEV ONLY. Startup must refuse to boot with this false when APP_ENV=production.
# ------------------------------------------------------------------------------

REQUIRE_AUTH=false
