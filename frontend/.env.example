# ==============================================================================
# PayPilot frontend configuration
#
# Copy to frontend/.env and fill in.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the production
# bundle. Anything here is PUBLIC — readable by anyone who opens devtools.
#
# Only the anon key belongs here. The service_role key must never be added to
# this file under any name. It bypasses Row Level Security entirely.
# ==============================================================================

# FastAPI backend base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → Project API keys → anon (public)
# Safe to expose: constrained by the RLS policies in supabase/migrations.
# Reads are limited to tickets, agent_trace_logs, and exception_list.
VITE_SUPABASE_ANON_KEY=
